*.sublime-workspace

# Editor/OS files
.DS_Store
.history/
*.swp
*.swo
*~

# =============================================================================
# Data & Models
# =============================================================================
# Ignore the CONTENTS of data folders (datasets) and common large data file extensions,
# but keep Python source that lives inside them (loaders, preprocessing).
# Ignoring the folders themselves (data/, models/) kept 62 .py files out of the repo before 2026-11-23.
**/data/**
!**/data/**/
!**/data/**/*.py
**/datasets/**
!**/datasets/**/
!**/datasets/**/*.py
*.csv
*.json
*.jsonl
*.parquet
*.xls
*.xlsx
*.db
*.sqlite
*.sqlite3

# Keep sample data if needed, by un-commenting the lines below
# !data/sample.csv
# !datasets/sample_dataset/

# Trained models and model checkpoints (the weights), but keep model source code
**/models/**
!**/models/**/
!**/models/**/*.py
model_registry/
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx
*.pb
*.tflite

# =============================================================================
# Notebooks & Testing
# =============================================================================
.ipynb_checkpoints
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# =============================================================================
# Archives & Logs
# =============================================================================
# Large files & Archives
*.zip
*.tar.gz
*.rar
*.7z
*.gz
*.bz2

# Log files
logs/
*.log
!logs/.gitkeep

# =============================================================================
# Secrets & Credentials
# =============================================================================
# Environment variables
.env
.env*
!.env.example
!.env.template

# Cloud Provider credentials
.aws/
.azure/
.gcp/

# =============================================================================
# Other
# =============================================================================
# Docker
.dockerignore

# Temporary files
*.tmp
*.bak
temp/
tmp/
